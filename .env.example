# Template only. Copy to .env locally and export variables yourself.
# No automatic credential discovery, no hard-coded proxy, no bundled secrets.
ROBO_HARNESS_API_KEY=
ROBO_HARNESS_BASE_URL=https://openrouter.ai/api/v1
ROBO_HARNESS_MODEL=
# Optional explicit proxy; leave empty for a direct connection.
ROBO_HARNESS_PROXY=
# Optional comma-separated provider IDs for OpenRouter.
ROBO_HARNESS_PROVIDERS=
# Paths are user-supplied and relative to the current working directory.
LIBERO_ROOT=./external/LIBERO-PRO
LIBERO_CONFIG_PATH=./configs/libero.local
ROBO_HARNESS_SAM3_CHECKPOINT=./checkpoints/sam3.pt
ROBO_HARNESS_TAPNEXT_REPO=./external/tapnextpp
ROBO_HARNESS_TAPNEXT_CHECKPOINT=./checkpoints/tapnextpp.pt
